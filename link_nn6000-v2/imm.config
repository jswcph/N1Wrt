# --- Target 基础设置 ---
CONFIG_TARGET_ipq60xx=y
CONFIG_TARGET_ipq60xx_generic=y
CONFIG_TARGET_ipq60xx_generic_DEVICE_link_nn6000-v2=y

# --- NSS 硬件加速开启 (核心性能优化) ---
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
# NSS 支持常见的网络协议加速
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y

# --- 基础组件与无线驱动 ---
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_wpad-openssl=y

# --- 你的专属插件包 (根据 AX3000T 配置同步) ---
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-argon=y

# --- 存储与 USB 3.0 支持 (NN6000 硬件特性) ---
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_luci-app-diskman=y

# --- 内存优化 (512MB 配合 ZRAM 更稳) ---
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-config=y

# --- 移除不需要的固件大包以节省闪存 ---
# CONFIG_PACKAGE_luci-app-example is not set
